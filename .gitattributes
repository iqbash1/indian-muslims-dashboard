# Git-LFS tracks binary archive files in /sources/.
# /extracted/ and /canonical/ stay in regular git for diffability.

sources/**/*.pdf filter=lfs diff=lfs merge=lfs -text
sources/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
sources/**/*.xls filter=lfs diff=lfs merge=lfs -text
sources/**/*.zip filter=lfs diff=lfs merge=lfs -text
sources/**/*.dta filter=lfs diff=lfs merge=lfs -text
sources/**/*.sav filter=lfs diff=lfs merge=lfs -text
sources/**/*.7z filter=lfs diff=lfs merge=lfs -text
sources/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
sources/**/*.csv filter=lfs diff=lfs merge=lfs -text
sources/**/*.xml filter=lfs diff=lfs merge=lfs -text
sources/**/*.doc filter=lfs diff=lfs merge=lfs -text
sources/**/*.docx filter=lfs diff=lfs merge=lfs -text
sources/**/*.rar filter=lfs diff=lfs merge=lfs -text

# The ls/mla per-election affidavit compilations are small, human-readable
# reference tables (the archived L1 for ls-share / mla-share). Keep them as
# diffable plaintext in regular git, NOT LFS, so they stay reviewable on GitHub
# (the override must come AFTER the blanket sources/**/*.csv lfs rule above).
# -text: NO EOL normalisation, so the committed bytes (CRLF, as csv.writer emits,
# like canonical/*.csv) stay byte-stable and keep matching the .meta.json sha256.
sources/prs-eci-affidavits/*.csv -text !filter !diff !merge
