# Git-LFS tracks binary archive files in /sources/.
# /extracted/ and /canonical/ stay in regular git for diffability.

sources/**/*.pdf filter=lfs diff=lfs merge=lfs -text
sources/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
sources/**/*.xls filter=lfs diff=lfs merge=lfs -text
sources/**/*.zip filter=lfs diff=lfs merge=lfs -text
sources/**/*.dta filter=lfs diff=lfs merge=lfs -text
sources/**/*.sav filter=lfs diff=lfs merge=lfs -text
sources/**/*.7z filter=lfs diff=lfs merge=lfs -text
sources/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
sources/**/*.csv filter=lfs diff=lfs merge=lfs -text
