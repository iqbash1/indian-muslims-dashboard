{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric entry",
  "type": "object",
  "required": ["id", "name", "cluster", "unit", "sources", "geography_levels", "religions", "comparison_baselines", "phase", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string"},
    "cluster": {"enum": ["demographics", "education", "employment", "income", "health", "housing", "finance", "representation", "justice", "civic"]},
    "unit": {"type": "string"},
    "definition": {"type": "string"},
    "higher_is_better": {"type": ["boolean", "null"]},
    "sources": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"type": "string"},
        "cross_check": {"type": "array", "items": {"type": "string"}}
      }
    },
    "geography_levels": {"type": "array", "items": {"enum": ["national", "state", "district", "sub-district"]}},
    "religions": {"type": "array", "items": {"enum": ["muslim", "hindu", "sc", "st", "christian", "sikh", "buddhist", "jain", "other", "other_minority", "not_stated", "all"]}},
    "methodology_notes": {"type": "string"},
    "break_notes": {"type": ["string", "null"]},
    "comparison_baselines": {"type": "array", "items": {"type": "string"}},
    "phase": {"enum": [1, 2]},
    "status": {"enum": ["stub", "defined", "data-loaded", "live"]},
    "display": {
      "type": "object",
      "description": "How this metric is presented on the dashboard. Optional; metrics without a display block are not shown in the scorecard.",
      "properties": {
        "scorecard": {
          "type": "object",
          "required": ["label", "order"],
          "properties": {
            "include": {"type": "boolean", "default": true},
            "label": {"type": "string", "description": "Short name shown in scorecard table"},
            "reference": {"type": ["string", "null"], "description": "Religion key for gap computation (e.g. 'hindu'). null if no comparison."},
            "unit_format": {"enum": ["percent", "per_1000_live_births", "females_per_1000_males", "count", "rate_per_100k", "per_100k_population", "inr_per_month", "inr"]},
            "higher_is_better": {"type": ["boolean", "null"]},
            "order": {"type": "integer", "description": "Sort order in scorecard"},
            "special_render": {"enum": ["time_series_latest", "time_series_count"], "description": "Optional special-case rendering"}
          }
        }
      }
    }
  }
}
