// Cloudflare Workers Static Assets — serves the built dashboard at muslimdata.in.
// docs/ is the only thing the site ships; everything else in the repo is data
// pipeline + manifest + transforms.
//
// Deploys run from .github/workflows/deploy.yml (wrangler-action on push to
// main), which ships the COMMITTED docs/ — no Python, no rebuild in CI. Build
// docs/ locally, commit it, push. (Cloudflare's own "Connect to Git" build is
// deliberately NOT used: its clone smudges Git LFS and this repo LFS-tracks
// ~400 MB of sources/** the site never serves — see
// docs/runbooks/deploy-setup.md.)
{
  "name": "indian-muslims-dashboard",
  "compatibility_date": "2026-06-02",
  // worker.js runs FIRST for exactly two paths (everything else is served
  // directly by Static Assets and never invokes the Worker — fail-open):
  //   /assets/tour.mp4 — HTTP 206 byte-range shim (iOS Safari <video>)
  //   /mcp             — lite MCP server for AI assistants (reads docs/api/)
  "main": "worker.js",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/tour.mp4", "/mcp"]
  }
}
