// Cloudflare Workers Static Assets — serves the built dashboard at muslimdata.in.
// docs/ is the only thing the site ships; everything else in the repo is data
// pipeline + manifest + transforms.
//
// Auto-deploys via Cloudflare Workers Builds on every push to main. docs/ is
// committed pre-built, so the deploy does not need to run the Python build at
// all. Two supported configs:
//   - RECOMMENDED: dashboard Build command = empty -> Cloudflare just serves the
//     committed ./docs (no pip, no Python, smallest failure surface).
//   - Current:    Build command = `python3 dashboard/build.py`. This is safe
//     only because requirements.txt is the minimal deploy set (PyYAML, pure
//     Python). Do NOT add native deps (e.g. Pillow) to requirements.txt — a
//     flaky binary-wheel install there froze the site once. See
//     docs/runbooks/deploy-setup.md.
{
  "name": "indian-muslims-dashboard",
  "compatibility_date": "2026-06-02",
  // A tiny Worker (worker.js) runs FIRST only for /assets/tour.mp4 to add HTTP
  // 206 byte-range support, which Static Assets omits and iOS Safari requires
  // for <video>. Every other route bypasses it and is served directly by
  // Static Assets (run_worker_first is scoped to just the video path).
  "main": "worker.js",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/tour.mp4"]
  }
}
